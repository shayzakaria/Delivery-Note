// Cloudflare deployment as static assets (Workers). Cloudflare Pages works too:
// build command `npm run build`, output directory `dist` (see README).
{
  "name": "mody-delivery-note",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
