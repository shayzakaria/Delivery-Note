// Cloudflare deployment as static assets (Workers). Connected to GitHub via Workers Builds:
// build command `npm run build`, deploy command `npx wrangler deploy` (see README).
{
  "name": "delivery-note",
  "compatibility_date": "2026-09-30",
  // Every non-production branch gets its own preview URL (*-delivery-note.<account>.workers.dev)
  // for review before merging to main. Explicit, because the default follows workers_dev (off).
  "preview_urls": true,
  // Required by `wrangler preview` (Worker Previews). Empty: previews use the same static
  // assets and settings as production; there are no bindings, vars or secrets to override.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Attached automatically on every deploy; the zone must be in the same Cloudflare account.
  "routes": [
    { "pattern": "modycustomer.com", "custom_domain": true },
    { "pattern": "www.modycustomer.com", "custom_domain": true }
  ]
}
